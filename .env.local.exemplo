# Copie este arquivo pra ".env.local" e preencha com os valores reais
# (você pega esses valores no painel do Supabase: Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_chave_service_role

# ⚠️ A SUPABASE_SERVICE_ROLE_KEY é secreta — nunca cole ela em código que
# vai pro navegador, nem exponha publicamente. Ela só pode ser usada em
# arquivos de servidor (como app/api/.../route.js) e no script
# scripts/criar-logins.js.
